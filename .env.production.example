# Integración con n8n (opcional). Genera cada clave con: openssl rand -hex 32
# Clave que n8n manda como "Authorization: Bearer ..." a /api/integration/*
# INTEGRATION_API_KEY=""
# Webhook de n8n al que la plataforma avisa (Makers nuevos). En Docker: http://n8n:5678/webhook/alt3d-eventos
# INTEGRATION_WEBHOOK_URL=""
# Valor del encabezado x-alt3d-token que n8n verifica
# INTEGRATION_WEBHOOK_TOKEN=""

# Email SMTP (opcional — si no, los links de reset van a los logs)
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
